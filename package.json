{
  "name": "jdmgza-project-manager",
  "version": "1.0.0",
  "description": "Jdmgza Project Manager Monorepo",
  "private": true,
  "type": "module",

  "workspaces": [
    "apps/*",
    "packages/*"
  ],

  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=jdmgza-web",

    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },

  "keywords": [],
  "author": "Jdmgza",
  "license": "ISC",

  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0"
  }
}
